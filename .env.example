# ==============================================================================
# Multimodal Deepfake Detection and Explainable Digital Forensics System for Images and Videos
# Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN LOCAL CONFIGURATION VALUES
# NEVER COMMIT .env TO VERSION CONTROL
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
DEBUG=True

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Security & Session Settings
SECRET_KEY=replace_with_a_secure_random_key_min_32_characters

# Media Upload & Processing Settings
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.webp
ALLOWED_VIDEO_EXTENSIONS=.mp4,.avi,.mov,.mkv,.webm

# Video Analysis & Frame Sampling Configuration
VIDEO_SAMPLE_FRAMES=16
VIDEO_SAMPLE_WINDOW=300
VIDEO_FACE_DETECTOR=yunet
YUNET_MODEL_PATH=models/yunet/face_detection_yunet_2023mar.onnx
CROP_SIZE=224

# Model Weights and Artifact Paths
IMAGE_MODEL_PATH=models/image/best_image_detector.pt
VIDEO_MODEL_PATH=models/video/best_video_detector.pt
MODEL_DEVICE=cpu

# Forensic Report Configuration
REPORTS_OUTPUT_DIR=reports/
ORGANIZATION_NAME=Academic Digital Forensics Lab
FORENSIC_EXAMINER_TITLE=Lead Forensic Analyst

# Explainability Settings (Grad-CAM)
GRADCAM_TARGET_LAYER=auto
